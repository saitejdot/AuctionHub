# Production API URL (e.g. your Render backend URL)
VITE_API_URL=https://your-backend.onrender.com/api

# Production Socket URL (same Render backend, no /api suffix)
VITE_SOCKET_URL=https://your-backend.onrender.com

# Razorpay publishable key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
