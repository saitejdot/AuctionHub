PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7

# Upstash Redis (free tier): https://console.upstash.com
REDIS_URL=rediss://:your_upstash_password@your-endpoint.upstash.io:6380

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=AuctionHub <no-reply@auctionhub.com>

ADMIN_EMAIL=admin@auctionhub.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin

# Set to your Vercel frontend URL in production
CLIENT_URL=https://your-frontend.vercel.app
