# ── AuctionHub Server — Environment Variables ─────────────────────────────────
# Copy this to .env and fill in real values for local development.
# For production (Render), set these in the Render dashboard or via render.yaml.

PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=AuctionHub

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRE=7d
COOKIE_EXPIRE_DAYS=7

# ── Redis (for BullMQ auction scheduler) ──────────────────────────────────────
# Get a free instance at https://upstash.com
# Without this, auctions will NOT auto-close on their end time.
REDIS_URL=redis://localhost:6379

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=AuctionHub <your_email@gmail.com>

# ── Admin Account (seeded on first run) ───────────────────────────────────────
ADMIN_EMAIL=admin@auctionhub.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: http://localhost:5173
# Production: your Vercel URL, e.g. https://auction-hub.vercel.app
CLIENT_URL=http://localhost:5173
